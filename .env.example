# ---------------------------------------------------------------------------
# NexusSearch environment configuration
# Copy to `.env` and adjust. Values shown are development defaults.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# Data stores (compose overrides these to point at the service containers).
# Local dev without infra can leave these unset to use SQLite + in-memory.
DATABASE_URL=postgresql://nexus:nexuspass@localhost:5432/nexussearch
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://nexus:nexuspass@localhost:5672

# Passwords consumed by docker-compose
DB_PASSWORD=nexuspass
RABBITMQ_PASSWORD=nexuspass

# Security — MUST be replaced with a strong value in production.
JWT_SECRET=dev-secret-change-me-in-production-0001
JWT_ALGORITHM=HS256
JWT_ISSUER=nexussearch
JWT_AUDIENCE=nexussearch
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Inter-service URLs (compose sets these to container names)
SEARCH_API_URL=http://localhost:8001
ADMIN_API_URL=http://localhost:8005
RANKING_API_URL=http://localhost:8004

# Search
SEARCH_DEFAULT_PER_PAGE=10
SEARCH_MAX_PER_PAGE=50
SEARCH_CACHE_TTL=300
SUGGEST_MIN_LENGTH=2
SUGGEST_MAX_LIMIT=20

# Ranking
BM25_K1=1.5
BM25_B=0.75
PAGERANK_DAMPING=0.85
PAGERANK_ITERATIONS=100

# Frontend
VITE_API_URL=http://localhost:8000

# AI summaries (optional). Get a key from https://build.nvidia.com/ — never commit the real value.
NEMOTRON_API_KEY=
# Internal API key for scripts/auto_crawl.py
LUNA_API_KEY=
